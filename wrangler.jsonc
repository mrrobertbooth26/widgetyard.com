{
  "name": "widgetyard",
  "compatibility_date": "2026-09-08",
  "main": "./src/index.mjs",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAGE_COUNTER",
        "class_name": "PageCounter"
      }
    ]
  },
  "exports": {
    "PageCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
